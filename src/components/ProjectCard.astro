---
import Badge from './Badge.astro'
import GithubIcon from '../images/github.svg'
import { getEntries } from 'astro:content'

import LinkIcon from '../images/link.svg'
const { project } = Astro.props
const technologies = await getEntries(project.data.technologies)
---

<div class="project-card">
  <div class="project-card-title">
    <h3>
      {project.data.title}
      <a href=`project/${project.id}` class="link-secondary">
        <LinkIcon class="interactive" />
      </a>
    </h3>
    <div class="badges-container">
      {
        technologies.map((technology) => (
          <Badge
            technology={technology}
            transitionName={`badge-${project.id}-${technology.id}`}
          />
        ))
      }
    </div>
  </div>
  <p transition:name={`project-description-${project.id}`}>
    {project.data.description}
  </p>
  <div class="project-links">
    <a href={project.data.githubLink}>
      <GithubIcon class="interactive" />
    </a>
  </div>
</div>

<style>
  h3 {
    font-size: var(--font-body);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }
  .project-card {
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-surface);
    border-radius: var(--radius);
    border: var(--border);
    transition: border-color var(--transition-fast);
  }
  .project-card:hover {
    border-color: var(--border-outline);
  }
  .project-card-title {
    margin-bottom: var(--space-md);
  }
  p {
    color: var(--text-secondary);
    line-height: 1.5;
  }
  a {
    display: flex;
    text-decoration: none;
  }
  .project-links svg {
    width: var(--icon-md);
    height: auto;
    fill: var(--text);
    transition: fill var(--transition-fast);
  }
  .project-links {
    margin-top: var(--space-sm);
    display: flex;
  }
  .link-icon {
    display: none;
  }
  .link-icon svg {
    width: var(--icon-sm);
    height: auto;
    fill: var(--bg);
    stroke: var(--text);
  }
  .project-card:hover .link-icon {
    display: inline;
  }
  .link-icon:hover svg {
    stroke: var(--accent);
    cursor: pointer;
  }
  .badges-container {
    display: flex;
    gap: var(--space-8);
  }
</style>
