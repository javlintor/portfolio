---
const { title, description, link } = Astro.props
import Badge from './Badge.astro'
---

<div class="card project-card">
  <h3>{title}</h3>
  <div class="badges">
    <Badge technology="nvim" />
  </div>
  <p>{description}</p>
  <a href={link}>Find out more</a>
</div>

<style>
  h3 {
    font-size: 2rem;
    color: var(--text);
  }
  .project-card {
    width: 70vw;
    padding: var(--space-sm) var(--space-sm);
    transition: scale var(--transition-ease);
  }
  .project-card:hover {
    scale: 1.02;
    cursor: pointer;
  }
  .card {
    background: var(--gradient);
    padding: 1.5rem;
    border-radius: 1rem;
    border: var(--border);
    box-shadow: var(--shadow);
  }
  .card:hover {
    background: var(--gradient-hover);
  }
  .badges {
    display: flex;
    gap: var(--space-xs);
  }
</style>
