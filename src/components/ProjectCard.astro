---
import Badge from './Badge.astro'
import GithubIcon from '../images/github.svg'
import { getEntries } from 'astro:content'
import { marked } from 'marked'

import LinkIcon from '../images/link.svg'
const { project } = Astro.props
const technologies = await getEntries(project.data.technologies)
const descriptionHtml = marked.parseInline(project.data.description)
---

<div class="project-card">
  <div class="project-card-title">
    <h3>
      {project.data.title}
      <a href=`project/${project.id}` class="title-link interactive">
        <LinkIcon class="icon-sm" />
      </a>
    </h3>
    <div class="badges-container">
      {
        technologies.map((technology) => (
          <Badge
            technology={technology}
            transitionName={`badge-${project.id}-${technology.id}`}
          />
        ))
      }
    </div>
  </div>

  <p
    class="description"
    transition:name={`project-description-${project.id}`}
    set:html={descriptionHtml}
  />
  <div class="project-links">
    <a href={project.data.githubLink} class="interactive">
      <GithubIcon class="icon-md" />
    </a>
  </div>
</div>

<style>
  h3 {
    font-size: var(--font-body);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }
  .project-card {
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-surface);
    border-radius: var(--radius);
    border: var(--border);
    transition: border-color var(--transition-fast);
  }
  .project-card:hover {
    border-color: var(--border-outline);
  }
  .project-card-title {
    margin-bottom: var(--space-md);
  }
  p {
    color: var(--text-secondary);
    line-height: 1.5;
  }
  a {
    display: flex;
    text-decoration: none;
  }
  a.title-link {
    display: none;
    align-items: center;
    vertical-align: -0.15em;
  }
  .project-card:hover a.title-link {
    display: inline-flex;
  }
  .project-links {
    margin-top: var(--space-sm);
    display: flex;
  }
  .badges-container {
    display: flex;
    gap: var(--space-8);
  }
</style>
