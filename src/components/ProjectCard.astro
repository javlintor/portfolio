---
import Badge from './Badge.astro'
import GithubIcon from '../images/github.svg'
import { getEntries } from 'astro:content'

import LinkSecondaryIcon from '../images/link2.svg'
const { project } = Astro.props
const technologies = await getEntries(project.data.technologies)
---

<div class="project-card">
  <div class="project-card-title">
    <h3>
      {project.data.title}
      <a href=`project/${project.id}` class="link-secondary">
        <LinkSecondaryIcon class="interactive" />
      </a>
    </h3>
    {technologies.map((technology) => <Badge technology={technology} />)}
  </div>
  <p>{project.data.description}</p>
  <div class="project-links">
    <a href={project.data.githubLink}>
      <GithubIcon class="interactive" />
    </a>
  </div>
</div>

<style>
  h3 {
    font: var(--font-lg);
    font-weight: bold;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 1 auto;
    padding: var(--space-md) var(--space-lg);
    transition: all var(--transition-ease);
    background: var(--gradient);
    border-radius: 1rem;
    border: var(--border);
    box-shadow: var(--shadow);
  }
  .project-card:hover {
    background: var(--gradient-hover);
    transform: scale(1.02);
  }
  .project-card-title {
    margin-bottom: var(--space-lg);
  }
  a {
    display: flex;
  }
  .project-links svg {
    width: var(--icon-md);
    height: auto;
    fill: var(--text);
    transition: fill var(--transition-ease);
  }
  .project-links {
    margin-top: var(--space-sm);
    display: flex;
  }
  .link-secondary {
    display: none;
  }
  .link-secondary svg {
    width: var(--icon-sm);
    height: auto;
    fill: var(--bg);
    stroke: var(--text);
  }
  .project-card:hover .link-secondary {
    display: inline;
  }
  .link-secondary:hover svg {
    stroke: var(--primary);
    cursor: pointer;
  }
</style>
