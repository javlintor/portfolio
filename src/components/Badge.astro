---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
interface Props {
  technology: CollectionEntry<'technologies'>
}

const { technology } = Astro.props
const foregroundColor = technology.data.foregroundColor
const backgroundColor = technology.data.backgroundColor
---

<a class="badge" href={technology.data.link}>
  <Image src={technology.data.icon} alt={`${technology.data.label} logo`} />
  <span>{technology.data.label}</span>
</a>

<style define:vars={{ foregroundColor, backgroundColor }}>
  .badge {
    display: inline-flex;
    background-color: var(--backgroundColor);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--foregroundColor);
    font-size: var(--font-caption);
    align-items: center;
    gap: var(--space-sm);
    border-radius: var(--radius);
    user-select: none;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }
  .badge:hover {
    opacity: 0.8;
  }
  .badge span {
    color: var(--foregroundColor);
  }
  .badge img {
    width: 0.875rem;
    height: 0.875rem;
    object-fit: contain;
    box-shadow: none;
  }
</style>
