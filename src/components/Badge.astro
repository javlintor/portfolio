---
import { BadgeConfig } from '../data/techConfig'

const { technology, variant = 'solid', size = 'md', customColor } = Astro.props

const tech = BadgeConfig[technology] || {
  label: technology,
  icon: '/assets/tech/default.svg',
  colors: {
    background: '#f4f4f4',
    text: '#111',
    border: '#ccc',
  },
}

// Resolve colors (allow overrides)
const bg = customColor?.background || tech.colors.background
const text = customColor?.text || tech.colors.text
const border = customColor?.border || tech.colors.border

const variantStyles = {
  solid: `background:${bg}; color:${text}; border:none;`,
  outline: `background:transparent; color:${text}; border:1px solid ${border};`,
  minimal: `background:transparent; color:${text}; border:none; opacity:0.85;`,
}

const sizeStyles = {
  sm: 'padding:0.15rem 0.5rem; font-size:0.75rem;',
  md: 'padding:0.25rem 0.75rem; font-size:0.875rem;',
  lg: 'padding:0.4rem 1rem; font-size:1rem;',
}
---

<div
  class="badge"
  style={`${variantStyles[variant]} ${sizeStyles[size]}`}
  aria-label={`Technology: ${tech.label}`}
>
  <span>{tech.label}</span>
</div>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    font-weight: 500;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
    user-select: none;
  }

  .badge img {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  .badge:hover {
    transform: translateY(-1px);
  }

  .badge:active {
    transform: translateY(0);
    opacity: 0.9;
  }
</style>
