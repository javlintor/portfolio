---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
interface Props {
  technology: CollectionEntry<'technologies'>
}

const { technology } = Astro.props
const foregroundColor = technology.data.foregroundColor
const backgroundColor = technology.data.backgroundColor
---

<a class="badge interactive" href={technology.data.link}>
  <Image src={technology.data.icon} alt={`${technology.data.label} logo`} />
  <span>{technology.data.label}</span>
</a>

<style define:vars={{ foregroundColor, backgroundColor }}>
  .badge {
    display: inline-flex;
    background-color: var(--backgroundColor);
    padding: 4px 8px;
    border: 2px solid var(--foregroundColor);
    font-size: var(--font-xs);
    align-items: center;
    gap: var(--space-sm);
    border-radius: 9999px;
    user-select: none;
  }
  .badge span {
    color: var(--text);
  }
  .badge img {
    width: 0.875rem;
    height: 0.875rem;
    object-fit: contain;
    box-shadow: none;
  }
</style>
