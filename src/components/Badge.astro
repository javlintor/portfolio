---
import type { CollectionEntry } from 'astro:content'
interface Props {
  technology: CollectionEntry<'technologies'>
}

const { technology } = Astro.props
const foregroundColor = technology.data.foregroundColor
const backgroundColor = technology.data.backgroundColor
---

<a class="badge" href={technology.data.link}>
  <img src={technology.data.image} alt={`${technology.data.label} logo`} />
  <span>{technology.data.label}</span>
</a>

<style define:vars={{ foregroundColor, backgroundColor }}>
  .badge {
    display: inline-flex;
    background-color: var(--backgroundColor);
    padding: 4px 8px;
    border: 2px solid var(--foregroundColor);
    font-size: var(--font-size-sm);
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    font-weight: 500;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
    user-select: none;
  }

  .badge img {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  .badge:hover {
    transform: translateY(-1px);
    opacity: 0.8;
  }
</style>
