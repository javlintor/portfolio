---
const { class: className, ...rest } = Astro.props
---

<section class="hero-section" id={rest.id}>
  <slot />
</section>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 90%;
    height: 100vh;
    max-width: 1000px;
    margin: 0 auto;
  }
</style>
