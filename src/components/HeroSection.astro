---
const { class: className, ...rest } = Astro.props
---

<section class="hero-section" id={rest.id}>
  <slot />
</section>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    width: 90%;
    min-height: 90vh;
    max-width: 1200px;
    margin: var(--space-2xl) auto 0 auto;
  }
</style>
