---
import PipeIcon from '../../public/favicon.svg'
import ThemeToggle from './ThemeToggle.astro'
---

<header>
  <div class="header-container">
    <a href="/" class="logo-link">
      <PipeIcon class="pipe-icon" />
    </a>
    <nav class="nav">
      <a href="/#projects">Projects</a>
      <a href="/blog">Blog</a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0px;
    width: 100%;
    z-index: 99;
    background-color: var(--bg);
  }
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) 0;
    width: var(--section-width);
    margin: 0 auto;
  }
  .nav {
    display: flex;
    gap: var(--space-xl);
  }
  .nav a {
    font-size: var(--font-body);
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .nav a:hover {
    color: var(--accent);
  }
  .logo-link {
    text-decoration: none;
  }
  .pipe-icon {
    width: var(--space-xl);
    height: auto;
  }
</style>
