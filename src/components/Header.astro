---
import PipeIcon from '../../public/favicon.svg'
---

<header>
  <a href="/">
    <PipeIcon class="pipe-icon" />
  </a>
  <nav class="nav">
    <a href="/#projects">Projects</a>
    <a href="/blog">Blog</a>
    <a href="/#contact">Contact</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0px;
    width: 100%;
    display: flex;
    justify-content: space-evenly;
    padding: var(--space-lg) 0;
    z-index: 99;
  }
  header:not(.scrolled) {
    background-color: transparent;
    backdrop-filter: none;
  }

  header.scrolled {
    backdrop-filter: blur(5px);
  }

  .nav {
    display: flex;
    gap: var(--space-xl);
  }

  .nav a {
    font: var(--font-md);
    color: var(--text);
  }
  .nav a:hover {
    color: var(--text-40);
  }
  .pipe-icon {
    width: var(--space-xl);
    height: auto;
  }
</style>

<script>
  window.addEventListener('scroll', () => {
    const header = document.querySelector('header')
    if (!header) return
    if (window.scrollY > 50) {
      header.classList.add('scrolled')
    } else {
      header.classList.remove('scrolled')
    }
  })
</script>
