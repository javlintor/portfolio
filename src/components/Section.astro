---
const { title, className, ...rest } = Astro.props
---

<section class={`section ${className}`} id={rest.id}>
  {title && <h2 class="section-title">{title}</h2>}
  <slot />
</section>

<style>
  .section {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 10vh;
    height: 100vh;
  }
  .section-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--text);
  }
  h2 {
    margin: 0 0 var(-space-xl) 0;
  }
</style>
