---
const { title, className, ...rest } = Astro.props
import LinkIcon from '../components/LinkIcon.astro'
---

<section class={`section ${className}`} id={rest.id}>
  {
    title && (
      <h2 class="section-title">
        {title} <LinkIcon id={rest.id} />
      </h2>
    )
  }
  <slot />
</section>

<style>
  .section {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding-top: var(--space-md);
  }
  .section-title {
    gap: var(--space-md);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--text);
  }

  h2 {
    margin: 0 0 var(-space-xl) 0;
  }
</style>
