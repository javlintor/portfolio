---
const { title, className, ...rest } = Astro.props
---

<section class={`section ${className}`} id={rest.id}>
  {title && <h2 class="section-title">{title}</h2>}
  <slot />
</section>

<style>
  .section {
    width: var(--section-width);
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-4xl);
    margin-top: var(--space-4xl);
    min-height: 70vh;
  }
  .section.no-min-height {
    min-height: unset;
  }
  .section-title {
    font-size: var(--font-2xl);
    color: var(--text);
    margin-bottom: var(--space-xl);
  }
</style>
