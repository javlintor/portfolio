---
const { title, className, ...rest } = Astro.props
---

<section class={`section ${className}`} id={rest.id}>
  {title && <h2 class="section-title">{title}</h2>}
  <slot />
</section>

<style>
  .section {
    width: var(--section-width);
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-xl);
    min-height: 70vh;
  }
  .section-title {
    font: bold 2rem/2.5em var(--ff);
    color: var(--text);
  }
</style>
