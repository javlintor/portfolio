---
const { title, className, ...rest } = Astro.props
---

<section class={`section ${className}`} id={rest.id}>
  {title && <h2 class="section-title">{title}</h2>}
  <slot />
</section>

<style>
  .section {
    width: var(--section-width);
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }
  .section-title {
    font: var(--font-xl);
    font-weight: 700;
    color: var(--text);
  }
  h2 {
    margin: 0 0 var(-space-xl) 0;
  }
</style>
