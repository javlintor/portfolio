---
const { title, className, ...rest } = Astro.props
import LinkSVG from '../images/link.svg'
---

<section class={`section ${className}`} id={rest.id}>
  {
    title && (
      <h2 class="section-title">
        {title}
        <a href={`#${rest.id}`}>
          <LinkSVG class="link-icon interactive" />
        </a>
      </h2>
    )
  }
  <slot />
</section>

<style>
  .section {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding-top: var(--space-md);
  }
  .section-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--text);
  }

  h2 {
    margin: 0 0 var(-space-xl) 0;
  }
  .link-icon {
    display: none;
    width: var(--font-size-lg);
    height: var(--font-size-lg);
    fill: var(--text-muted);
    cursor: pointer;
  }
  h2:hover .link-icon {
    display: inline;
  }
  .link-icon:hover {
    fill: var(--primary);
    transition: fill var(--transition-ease);
  }
</style>
