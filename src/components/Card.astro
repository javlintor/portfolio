---
interface Props {
  href: string
  summary: string
  title: string
  image_src: string
}
const { href, summary, title, image_src } = Astro.props
---

<div class="max-w-sm rounded-lg border border-gray-200 bg-white shadow">
  <a href="#">
    <img class="rounded-t-lg" src={image_src} alt="" />
  </a>
  <div class="p-5">
    <a href="#">
      <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900">
        {title}
      </h5>
    </a>
    <p class="mb-3 font-normal text-gray-700">{summary}</p>
    <a
      href={href}
      class="inline-flex items-center rounded-lg bg-blue-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300"
    >
      Read more
      <svg
        class="ms-2 h-3.5 w-3.5 rtl:rotate-180"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"></path>
      </svg>
    </a>
  </div>
</div>
