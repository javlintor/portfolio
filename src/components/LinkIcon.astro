---
const { id } = Astro.props
import LinkSVG from '../images/link.svg'
---

<a href={`#${id}`}>
  <LinkSVG class="link-icon" />
</a>

<style>
  .link-icon {
    width: var(--font-size-lg);
    height: var(--font-size-lg);
    fill: var(--text-muted);
    cursor: pointer;
  }
  .link-icon:hover {
    fill: var(--primary);
    transition: fill var(--transition-ease);
  }
</style>
