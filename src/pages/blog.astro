---
import Layout from '../layouts/Layout.astro'
import { getEntry } from 'astro:content'
import { render } from 'astro:content'

const blog1 = await getEntry('blog', 'blog1')
const { Content } = await render(blog1)
---

<Layout title="Blog" description="Blog of Javier Linares">
  <article class="markdown">
    <Content />
  </article>
</Layout>
