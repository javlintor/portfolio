---
import Badge from '../../components/Badge.astro'
import { getCollection, getEntries, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const technologies = await getEntries(project.data.technologies)
import '../../styles/markdown.css'
---

<Layout
  title=`Javier Linares Project`
  description=`Details on the Project develop by Data Engineer`
>
  <article class="markdown">
    <Content />
  </article>
  <!-- prettier-ignore -->
  {
    // prettier-ignore
    technologies.map((technology) => (<Badge technology={technology} />))
  }
</Layout>
