---
import Layout from '../layouts/Layout.astro'
import HeroSection from '../components/HeroSection.astro'
import Section from '../components/Section.astro'
import ProjectCard from '../components/ProjectCard.astro'
import GithubIcon from '../assets/github.svg'
import LinkedInIcon from '../assets/linkedin.svg'
import MaltIcon from '../assets/malt.svg'
import '../styles/global.css'
---

<Layout
  title="Javier Linares | Data Engineer - Desarrollador especializado en Ingeniería de datos"
  description="Data Engineer con experiencia multidisciplinaria en banca, logística, supply chain y analítica web. Domino el ecosistema moderno de datos: dbt, Databricks, PySpark, Airflow, Terraform y Kubernetes sobre AWS. Me enfoco en la arquitectura, orquestación y automatización de flujos de datos escalables y eficientes."
>
  <HeroSection>
    <div>
      <h1 class="hero-title animate__animated animate__fadeIn">
        <span>Data</span>
        <br />
        <span class="gradient-text">Engineering</span>
        <br /><span>Solutions</span>
      </h1>
      <h2 class="animate__animated animate__fadeInLeft">Javier Linares</h2>
      <div class="subtitle-icons animate__animated animate__fadeInUp">
        <a href="https://github.com/javlintor">
          <GithubIcon />
        </a>
        <a href="https://linkedin.com/javlintor">
          <LinkedInIcon />
        </a>
        <a href="https://malt.com/javlintor">
          <MaltIcon />
        </a>
      </div>
    </div>
    <div class="container-center">
      <a
        href="#projects"
        class="btn-action animate__animated animate__infinite animate__pulse"
        >Conoce más 👇</a
      >
    </div>
  </HeroSection>
  <Section title="Projects" id="projects">
    <ProjectCard
      title="My Neovim config"
      description="Check out my Neovim config focused on python, dbt and react development."
      link="www.github/javlintor"
    />
    <ProjectCard
      title="Manoli Bakes"
      description="Management system based on Whatsapp API and MCP for bakery operations."
      link="www.github/javlintor"
    />
  </Section>
  <Section title="Contact" id="contact">
    Hola! Soy <strong>Javier Linares</strong>, Data Engineer.
  </Section>
  <footer>
    Build with <a href="https://astro.build/">Astro</a>
  </footer>
</Layout>

<style>
  .subtitle-icons {
    display: flex;
    gap: var(--space-sm);
  }
  .subtitle-icons svg {
    width: var(--font-size-lg);
    height: var(--font-size-lg);
    fill: var(--text);
    transition: fill var(--transition-ease);
  }
  .subtitle-icons svg:hover {
    fill: var(--primary);
  }
</style>
