---
const { class: className, ...rest } = Astro.props
import GithubIcon from '../images/github.svg'
import LinkedInIcon from '../images/linkedin.svg'
import MaltIcon from '../images/malt.svg'
import DownIcon from '../images/down.svg'
---

<section class="hero-section" id={rest.id}>
  <div>
    <h1 class="animate__animated animate__fadeIn">
      <span>Data</span>
      <br />
      <span class="gradient-text">Engineering</span>
      <br />
      <span>Solutions</span>
    </h1>
    <h2 class="animate__animated animate__fadeInLeft">Javier Linares 🧑🏻‍💻</h2>
    <div class="subtitle-icons animate__animated animate__fadeInUp">
      <a href="https://github.com/javlintor" class="interactive">
        <GithubIcon />
      </a>
      <a href="https://linkedin.com/javlintor" class="interactive">
        <LinkedInIcon />
      </a>
      <a href="https://malt.com/javlintor" class="interactive">
        <MaltIcon />
      </a>
    </div>
  </div>
  <div class="container-center">
    <a
      href="#projects"
      class="animate__animated animate__infinite animate__pulse"
      ><DownIcon id="scroll-button" /></a
    >
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: var(--section-width);
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-xl);
    min-height: 90vh;
  }
  h1 {
    color: var(--text-20);
    font: var(--font-4xl);
    letter-spacing: 1px;
    margin-bottom: var(--space-lg);
    margin-top: var(--space-sm);
  }
  h1 .h1-secondary {
    font: var(--font-4xl);
    font-weight: normal;
  }
  h2 {
    font: 2rem/1.4em var(--ff);
    color: var(--text-30);
    margin-bottom: var(--space-md);
  }
  .subtitle-icons {
    display: flex;
    gap: var(--space-xl);
  }
  .subtitle-icons svg {
    width: var(--icon-lg);
    height: auto;
  }
  #scroll-button {
    fill: var(--accent);
    width: var(--icon-lg);
    height: auto;
  }
  #scroll-button:hover {
    fill: var(--primary);
    transition: fill var(--transition-ease);
  }
</style>
