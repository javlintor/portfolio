---
const { class: className, ...rest } = Astro.props
import GithubIcon from '../images/github.svg'
import LinkedInIcon from '../images/linkedin.svg'
import MaltIcon from '../images/malt.svg'
import DownIcon from '../images/down.svg'
---

<section class="hero-section" id={rest.id}>
  <div>
    <h1 class="hero-title animate__animated animate__fadeIn">
      <span>Data</span>
      <br />
      <span class="gradient-text">Engineering</span>
      <br /><span>Solutions</span>
    </h1>
    <h2 class="animate__animated animate__fadeInLeft">Javier Linares</h2>
    <div class="subtitle-icons animate__animated animate__fadeInUp">
      <a href="https://github.com/javlintor" class="interactive">
        <GithubIcon />
      </a>
      <a href="https://linkedin.com/javlintor" class="interactive">
        <LinkedInIcon />
      </a>
      <a href="https://malt.com/javlintor" class="interactive">
        <MaltIcon />
      </a>
    </div>
  </div>
  <div class="container-center">
    <a
      href="#projects"
      class="animate__animated animate__infinite animate__pulse"
      ><DownIcon id="scroll-button" /></a
    >
  </div>
</section>

<style>
  h1 {
    font-weight: 700;
    color: var(--text);
    font-size: var(--font-size-4xl);
  }

  h2 {
    font-weight: 400;
    font-size: var(--font-size-lg);
  }
  .hero-title {
    margin: 0;
  }
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 90%;
    max-width: 1000px;
    margin: 0 auto;
  }
  .subtitle-icons {
    display: flex;
    gap: var(--space-md);
  }
  .subtitle-icons svg {
    width: var(--space-md);
    height: auto;
  }
  #scroll-button {
    fill: var(--accent);
    width: var(--space-md);
    height: var(--space-md);
  }
  #scroll-button:hover {
    fill: var(--primary);
    transition: fill var(--transition-ease);
  }
</style>
