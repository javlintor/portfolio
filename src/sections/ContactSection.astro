---
import Section from '../components/Section.astro'
import { Image } from 'astro:assets'
import ProfileImage from '../images/javi.webp'
---

<Section title="Contact" id="contact">
  <div class="contact-container">
    <div class="first">
      <h3>Hi! 👋</h3>
      <p>
        I am <mark>Javier Linares</mark>, a <strong>Data Engineer</strong>.
      </p>
      <p>
        I have <ins>5 years</ins> of experience building solutions that help companies
        improve their operations and analytics through <strong>software</strong>
        and <strong>data-driven systems</strong>.
      </p>
    </div>
    <Image
      src={ProfileImage}
      alt="Javier Linares"
      width="300"
      class="profile-image"
    />
  </div>
  <div class="button-container">
    <a href="mailto:your@email.com?subject=Booking%20a%20Call&body=Hi%20Javier,"
      >Book a call</a
    >
  </div>
</Section>
<style>
  h3 {
    font-size: var(--font-size-lg);
  }
  p {
    font-size: var(--font-size-md);
    line-height: 1.7;
  }
  .contact-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    justify-content: center;
  }
  .first {
    max-width: 600px;
  }
  .profile-image {
    border-radius: 8px;
  }
  .button-container {
    margin-top: var(--space-md);
    display: flex;
    justify-content: center;
  }
  .button-container a {
    background: var(--accent);
    padding: 0.5rem 1rem 0.7rem 1rem;
    color: var(--text);
    font-size: var(--font-size-md);
    font-weight: 700;
    border-radius: 0.5rem;
    border: var(--border);
    box-shadow: var(--shadow);
    cursor: pointer;
    text-decoration: none;
    transition: all ease 0.2s;
  }
  .button-container a:hover {
    background: var(--primary);
    scale: 1.05;
  }
</style>
