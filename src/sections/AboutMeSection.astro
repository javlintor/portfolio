---
import Section from '../components/Section.astro'
import { Image } from 'astro:assets'
import ProfileImage from '../images/javi.webp'
import GithubIcon from '../images/github.svg'
import LinkedInIcon from '../images/linkedin.svg'
import MaltIcon from '../images/malt.svg'
---

<Section id="contact" className="no-min-height">
  <div class="contact-container">
    <Image
      src={ProfileImage}
      alt="Javier Linares"
      width="200"
      class="profile-image"
    />
    <div class="first">
      <h3>
        <mark>Javi Linares</mark> is a <strong>Data Engineer</strong> with a passion
        for innovation and problem-solving.
      </h3>
      <p class="bio">
        <ins>5 years</ins> of experience building solutions that help companies improve
        their operations and analytics through <strong>software</strong>
        and <strong>data-driven systems</strong>.
      </p>
      <div class="subtitle-icons">
        <a href="https://github.com/javlintor" class="interactive">
          <GithubIcon class="icon-lg" />
        </a>
        <a href="https://linkedin.com/javlintor" class="interactive">
          <LinkedInIcon class="icon-lg" />
        </a>
        <a href="https://malt.com/javlintor" class="interactive">
          <MaltIcon class="icon-lg" />
        </a>
      </div>
    </div>
  </div>
</Section>
<style>
  p {
    font-size: var(--font-body);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  p.bio {
    font-size: var(--font-body);
    margin-top: var(--space-lg);
  }
  .contact-container {
    display: flex;
    gap: var(--space-3xl);
    align-items: center;
  }
  .first {
    flex: 1;
    min-width: 260px;
  }
  .profile-image {
    border-radius: 50%;
    border: 1px solid var(--border-outline);
    width: clamp(100px, 15vw, 200px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 0%;
    flex-shrink: 0;
    box-shadow: 0 2px 4px rgba(15, 0, 0, 0.08);
  }
  .subtitle-icons {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
  .subtitle-icons a {
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .contact-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .subtitle-icons {
      justify-content: center;
    }
    .profile-image {
      width: clamp(80px, 30vw, 120px);
    }
  }
</style>
