---
import Section from '../components/Section.astro'
import { Image } from 'astro:assets'
import ProfileImage from '../images/javi.webp'
import GithubIcon from '../images/github.svg'
import LinkedInIcon from '../images/linkedin.svg'
import MaltIcon from '../images/malt.svg'
---

<Section id="contact" className="no-min-height">
  <div class="contact-container">
    <div class="first">
      <h3>Hi! 👋</h3>
      <p>
        I am <mark>Javier Linares</mark>, a <strong>Data Engineer</strong>.
      </p>
      <p class="bio">
        I have <ins>5 years</ins> of experience building solutions that help companies
        improve their operations and analytics through <strong>software</strong>
        and <strong>data-driven systems</strong>.
      </p>
      <div class="subtitle-icons animate__animated animate__fadeInUp">
        <a href="https://github.com/javlintor" class="interactive">
          <GithubIcon />
        </a>
        <a href="https://linkedin.com/javlintor" class="interactive">
          <LinkedInIcon />
        </a>
        <a href="https://malt.com/javlintor" class="interactive">
          <MaltIcon />
        </a>
      </div>
    </div>
    <Image
      src={ProfileImage}
      alt="Javier Linares"
      width="320"
      class="profile-image"
    />
  </div>
</Section>
<style>
  h3 {
    font-size: var(--font-2xl);
    margin-bottom: var(--space-lg);
  }
  p {
    font-size: var(--font-lg);
    line-height: 1.8;
    color: var(--text-subtle);
  }
  p.bio {
    font-size: var(--font-md);
    margin-top: var(--space-lg);
  }
  .contact-container {
    display: flex;
    gap: var(--space-3xl);
    align-items: center;
  }
  .first {
    flex: 1;
    min-width: 260px;
  }
  .profile-image {
    border-radius: 50%;
    border: var(--border);
    width: clamp(200px, 25vw, 320px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 0%;
    flex-shrink: 0;
    transition: box-shadow var(--transition-ease);
  }
  .profile-image:hover {
    box-shadow:
      0 8px 16px hsl(0 0% 0% / 0.12),
      0 0 0 4px var(--secondary);
  }
  .subtitle-icons {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
  .subtitle-icons svg {
    width: var(--icon-lg);
    height: auto;
  }
  @media (max-width: 750px) {
    .contact-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .subtitle-icons {
      justify-content: center;
    }
    .profile-image {
      width: clamp(160px, 50vw, 240px);
    }
  }
</style>
