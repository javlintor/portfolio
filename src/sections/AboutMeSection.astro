---
import Section from '../components/Section.astro'
import { Image } from 'astro:assets'
import ProfileImage from '../images/javi.webp'
---

<Section id="contact" className="no-min-height">
  <div class="contact-container">
    <div class="first">
      <h3>Hi! 👋</h3>
      <p>
        I am <mark>Javier Linares</mark>, a <strong>Data Engineer</strong>.
      </p>
      <br />
      <p>
        I have <ins>5 years</ins> of experience building solutions that help companies
        improve their operations and analytics through <strong>software</strong>
        and <strong>data-driven systems</strong>.
      </p>
      <div class="button-container">
        <a href="mailto:your@email.com?subject=Booking%20a%20Call&body=Hi%20Javier,"
          >Book a call</a
        >
      </div>
    </div>
    <Image
      src={ProfileImage}
      alt="Javier Linares"
      width="280"
      class="profile-image"
    />
  </div>
</Section>
<style>
  h3 {
    font-size: var(--font-2xl);
    margin-bottom: var(--space-xl);
  }
  p {
    font-size: var(--font-lg);
    line-height: 1.7;
    color: var(--text-subtle);
  }
  .contact-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xl);
    align-items: center;
  }
  .first {
    flex: 1;
    min-width: 280px;
  }
  .profile-image {
    border-radius: 12px;
    border: var(--border);
    transition: box-shadow var(--transition-ease);
  }
  .profile-image:hover {
    box-shadow:
      0 8px 16px hsl(0 0% 0% / 0.12),
      0 0 0 4px var(--secondary);
  }
  .button-container {
    margin-top: var(--space-2xl);
  }
  .button-container a {
    background: var(--secondary);
    padding: 0.5rem 1.5rem 0.7rem 1.5rem;
    color: var(--text);
    font-size: var(--font-md);
    font-weight: 700;
    border-radius: 0.5rem;
    border: var(--border);
    box-shadow: var(--shadow);
    cursor: pointer;
    text-decoration: none;
    transition: all var(--transition-ease);
    font-family: var(--ff);
  }
  .button-container a:hover {
    background: var(--accent);
    scale: 1.05;
  }
</style>
